# Secure Examination Management and Delivery Platform — environment example.
#
# Copy to apps/api/.env for local development:
#   cp .env.example apps/api/.env
#
# Every value here is a development placeholder. The API validates this
# configuration at startup and refuses to run with an invalid one.

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Exact origin allowed by CORS. No wildcards are accepted.
WEB_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
# Signs the HTTP-only session cookie. Minimum 32 characters.
# The API refuses to start in production while this is the development default.
SESSION_SECRET=development-only-session-secret-change-me-01
SESSION_TTL_MINUTES=60

# ----------------------------------------------------------------------------
# Persistence
# ----------------------------------------------------------------------------
# memory   — in-process demo store, no infrastructure required (default)
# postgres — Prisma/PostgreSQL using DATABASE_URL
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://sep:development-only-password@localhost:5432/secure_exam

# memory | redis
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# memory | s3   (s3 also covers MinIO)
OBJECT_STORE_DRIVER=memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=exam-evidence
S3_ACCESS_KEY=sep-development
S3_SECRET_KEY=development-only-secret

# ----------------------------------------------------------------------------
# Key management
# ----------------------------------------------------------------------------
# local — LocalDevelopmentKeyProvider. Ephemeral keys held in application
#         memory. NOT SUITABLE FOR PRODUCTION; the API refuses to start with
#         KEY_PROVIDER=local when NODE_ENV=production.
# kms   — CloudKmsProvider placeholder. Not implemented in this proof of
#         concept; integrate a cloud KMS or HSM before enabling it.
KEY_PROVIDER=local
KMS_KEY_ID=

# ----------------------------------------------------------------------------
# Demonstration controls
# ----------------------------------------------------------------------------
# Enables the presenter Demo Mode drawer, the /demo-scenarios routes and the
# demo credential listing. Automatically disabled when NODE_ENV=production.
ENABLE_DEMO_MODE=true

# Separation of duties escape hatch. Leave false: with it off, an author cannot
# approve their own question and a paper's assembler cannot approve its
# publication. Only enable it for a single-operator demonstration.
ALLOW_SELF_APPROVAL=false

# ----------------------------------------------------------------------------
# Rate limiting and lockout
# ----------------------------------------------------------------------------
RATE_LIMIT_MAX=600
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=10

# Optional HTTPS bridge to the enrolled-identity and liveness provider.
# With no provider, export comparison is simulated only when demo mode is enabled.
# With demo mode disabled, exports remain blocked until this integration is configured.
EXPORT_FACE_PROVIDER_URL=
EXPORT_FACE_PROVIDER_TOKEN=
